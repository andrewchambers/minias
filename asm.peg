    ws i:imm8 ws? ',' ws? s:r32 ws? ',' ws? d:xmm { $$ = IMMREGREG2({.w=0}, 0x66, 0x01000fc4, i, s, d); }
  | ws i:imm8 ws? ',' ws? s:mem ws? ',' ws? d:xmm { $$ = IMMMEMREG({.w=0}, 0x66, 0x01000fc4, i, s, d); }
)

packuswb = "packuswb" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000f67, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000f67, s, d); }
)

paddb = "paddb" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000ffc, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000ffc, s, d); }
)

paddw = "paddw" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000ffd, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000ffd, s, d); }
)

paddd = "paddd" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000ffe, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000ffe, s, d); }
)

paddq = "paddq" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000fd4, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000fd4, s, d); }
)

psubq = "psubq" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000ffb, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000ffb, s, d); }
)

psubd = "psubd" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000ffa, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000ffa, s, d); }
)

punpcklbw = "punpcklbw" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000f60, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000f60, s, d); }
)

punpcklwd = "punpcklwd" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000f61, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000f61, s, d); }
)

punpckldq = "punpckldq" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000f62, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000f62, s, d); }
)

punpckhbw = "punpckhbw" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000f68, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000f68, s, d); }
)

punpckhdq = "punpckhdq" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000f6a, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000f6a, s, d); }
)

punpckhwd = "punpckhwd" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000f69, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000f69, s, d); }
)

punpckhqdq = "punpckhqdq" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000f6d, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000f6d, s, d); }
)

punpcklqdq = "punpcklqdq" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000f6c, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000f6c, s, d); }
)

xorpd = "xorpd" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000f57, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000f57, s, d); }
)

xorps = "xorps" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, -1, 0x01000f57, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, -1, 0x01000f57, s, d); }
)

r64_or_rip = (
    r:r64
  | r:rip
) { $$ = r; }

mem =
    seg:segment d:value ws? sib:opt_scale_index_base { $$ = (Parsev){ .memarg=sib.memarg }; $$.memarg.disp = d.value; $$.memarg.segment = seg.i64; }
  | seg:segment sib:scale_index_base { $$ = (Parsev){ .memarg=sib.memarg }; $$.memarg.segment = seg.i64; }
  | d:value ws? sib:opt_scale_index_base { $$ = (Parsev){ .memarg=sib.memarg }; $$.memarg.disp = d.value; }
  | sib:scale_index_base { $$ = (Parsev){ .memarg=sib.memarg }; }

segment =
    "%fs:" { $$.i64 = 0x64; }
  | "%gs:" { $$.i64 = 0x65; }

opt_scale_index_base =
    sib:scale_index_base { $$ = sib; }
  | {  $$.memarg = (Memarg){.kind=ASM_MEMARG, .scale = 0, .index=ASM_NO_REG, .base = ASM_NO_REG, .disp = {0}  }; }

scale_index_base =
     '(' ws? b:r64_or_rip ws? ')'
     {  $$.memarg = (Memarg){.kind=ASM_MEMARG, .scale = 0, .index=ASM_NO_REG, .base = b.kind, .disp = {0}  }; }
   | '(' ws? ',' ws? i:r64 ws? ',' ws? s:number ws? ')'
     {  $$.memarg = (Memarg){.kind=ASM_MEMARG, .scale = s.i64, .index=i.kind, .base = ASM_NO_REG, .disp = {0}  }; }
   | '(' ws? ',' ws? i:r64 ws? ')'
     {  $$.memarg = (Memarg){.kind=ASM_MEMARG, .scale = 1, .index=i.kind, .base = ASM_NO_REG, .disp = {0}  }; }
   | '(' ws? b:r64 ws? ',' ws? i:r64 ws? ',' ws? s:number ws? ')'
     {  $$.memarg = (Memarg){.kind=ASM_MEMARG, .scale = s.i64, .index=i.kind, .base = b.kind, .disp = {0}  }; }
   | '(' ws? b:r64 ws? ',' ws? i:r64 ')'
     {  $$.memarg = (Memarg){.kind=ASM_MEMARG, .scale = 1, .index=i.kind, .base = b.kind, .disp = {0}  }; }


imm =
    '$' ws? val:value
    { $$ = (Parsev) { .imm = (Imm){ .kind = ASM_IMM, .v = val.value, .nbytes = 0} }; }

imm8 = i:imm { i.imm.nbytes = 1; $$ = i; }
imm16 = i:imm { i.imm.nbytes = 2; $$ = i; }
imm32 = i:imm { i.imm.nbytes = 4; $$ = i; }

imm16_8 = i:imm {
  i.imm.nbytes = 2;
  if (i.imm.v.l == NULL) {
    if ((int64_t)(int8_t)i.imm.v.c == i.imm.v.c)  {
      i.imm.nbytes = 1;
    }
  }
  $$ = i;
}
imm32_8 = i:imm {
  i.imm.nbytes = 4;
  if (i.imm.v.l == NULL) {
    if ((int64_t)(int8_t)i.imm.v.c == i.imm.v.c) {
      i.imm.nbytes = 1;
    }
  }
  $$ = i;
}

al = "%al" { $$ = REG(AL); }
cl = "%cl" { $$ = REG(CL); }
ax = "%ax" { $$ = REG(AX); }
eax = "%eax" { $$ = REG(EAX); }
rax = "%rax" { $$ = REG(RAX); }
rip = "%rip" { $$ = REG(RIP); }

r8 = '%' (
    "al" { $$ = REG(AL); }
  | "cl" { $$ = REG(CL); }
  | "dl" { $$ = REG(DL); }
  | "bl" { $$ = REG(BL); }
  | "ah" { $$ = REG(AH); }
  | "ch" { $$ = REG(CH); }
  | "dh" { $$ = REG(DH); }
  | "bh" { $$ = REG(BH); }
  | "spl" { $$ = REG(SPL); }
  | "bpl" { $$ = REG(BPL); }
  | "sil" { $$ = REG(SIL); }
  | "dil" { $$ = REG(DIL); }
  | "r8b"  { $$ = REG(R8B); }
  | "r9b"  { $$ = REG(R9B); }
  | "r10b" { $$ = REG(R10B); }
  | "r11b" { $$ = REG(R11B); }
  | "r12b" { $$ = REG(R12B); }
  | "r13b" { $$ = REG(R13B); }
  | "r14b" { $$ = REG(R14B); }
  | "r15b" { $$ = REG(R15B); }
)

r16 = '%' (
    "ax" { $$ = REG(AX); }
  | "cx" { $$ = REG(CX); }
  | "dx" { $$ = REG(DX); }
  | "bx" { $$ = REG(BX); }
  | "sp" { $$ = REG(SP); }
  | "bp" { $$ = REG(BP); }
  | "si" { $$ = REG(SI); }
  | "di" { $$ = REG(DI); }
  | "r8w"  { $$ = REG(R8W); }
  | "r9w"  { $$ = REG(R9W); }
  | "r10w" { $$ = REG(R10W); }
  | "r11w" { $$ = REG(R11W); }
  | "r12w" { $$ = REG(R12W); }
  | "r13w" { $$ = REG(R13W); }
  | "r14w" { $$ = REG(R14W); }
  | "r15w" { $$ = REG(R15W); }
)

r32 = '%' (
    "eax" { $$ = REG(EAX); }
  | "ecx" { $$ = REG(ECX); }
  | "edx" { $$ = REG(EDX); }
  | "ebx" { $$ = REG(EBX); }
  | "esp" { $$ = REG(ESP); }
  | "ebp" { $$ = REG(EBP); }
  | "esi" { $$ = REG(ESI); }
  | "edi" { $$ = REG(EDI); }
  | "r8d"  { $$ = REG(R8D); }
  | "r9d"  { $$ = REG(R9D); }
  | "r10d" { $$ = REG(R10D); }
  | "r11d" { $$ = REG(R11D); }
  | "r12d" { $$ = REG(R12D); }
  | "r13d" { $$ = REG(R13D); }
  | "r14d" { $$ = REG(R14D); }
  | "r15d" { $$ = REG(R15D); }
)

r64 = "%r" (
    "ax" { $$ = REG(RAX); }
  | "cx" { $$ = REG(RCX); }
  | "dx" { $$ = REG(RDX); }
  | "bx" { $$ = REG(RBX); }
  | "sp" { $$ = REG(RSP); }
  | "bp" { $$ = REG(RBP); }
  | "si" { $$ = REG(RSI); }
  | "di" { $$ = REG(RDI); }
  | "8"  ![lwb] { $$ = REG(R8); }
  | "9"  ![lwb] { $$ = REG(R9); }
  | "10" ![lwb] { $$ = REG(R10); }
  | "11" ![lwb] { $$ = REG(R11); }
  | "12" ![lwb] { $$ = REG(R12); }
  | "13" ![lwb] { $$ = REG(R13); }
  | "14" ![lwb] { $$ = REG(R14); }
  | "15" ![lwb] { $$ = REG(R15); }
)

xmm = "%xmm" (
  # Reverse order due to peg ordering.
    "15" { $$ = REG(XMM15); }
  | "14" { $$ = REG(XMM14); }
  | "13" { $$ = REG(XMM13); }
  | "12" { $$ = REG(XMM12); }
  | "11" { $$ = REG(XMM11); }
  | "10" { $$ = REG(XMM10); }
  | "9"  { $$ = REG(XMM9); }
  | "8"  { $$ = REG(XMM8); }
  | "7"  { $$ = REG(XMM7); }
  | "6"  { $$ = REG(XMM6); }
  | "5"  { $$ = REG(XMM5); }
  | "4"  { $$ = REG(XMM4); }
  | "3"  { $$ = REG(XMM3); }
  | "2"  { $$ = REG(XMM2); }
  | "1"  { $$ = REG(XMM1); }
  | "0"  { $$ = REG(XMM0); }
)

x87st = "%st(" <[0-7]> ")"
  { $$.i64 = strtoull(yytext, NULL, 10); }

x87st_any =
    s:x87st { $$ = s; }
  | "%st" !'(' { $$.i64 = 0; }

# We disallow newlines in our strings, it is simpler for lineno tracking.
string = '"' <(string_escape | ( ! '\n' ! '\\' !'"' .))*> '"'
         { $$.string = decodestring(yytext); }

string_escape = '\\' (
    '\\'
  | '"'
  | [abfnrtv]
  | 'x' [0-9A-Fa-f]+
  | [0-7][0-7][0-7]
)

value =
    '(' e:const_expression ')' { $$.value = (Value){ .l = NULL, .c = e.i64 }; }
  | n:number ws? "<<" ws? m:number { $$.value = (Value){ .l = NULL, .c = n.i64 << m.i64 }; }
  | n:number ws? ">>" ws? m:number { $$.value = (Value){ .l = NULL, .c = (int64_t)((uint64_t)n.i64 >> m.i64) }; }
  | n:number ws? '+' ws? m:number { $$.value = (Value){ .l = NULL, .c = n.i64 + m.i64 }; }
  | n:number ws? '-' ws? m:number { $$.value = (Value){ .l = NULL, .c = n.i64 - m.i64 }; }
  | n:number ws? '+' ws? i:ident { $$.value = (Value){ .l = i.charptr, .c = n.i64 }; }
  | n:number { $$.value = (Value){ .l = NULL, .c = n.i64 }; }
  |
    i:ident r:reloc_modifier ws? (
      '+' ws? n:number    { $$.value = (Value){ .c = n.i64 }; }
      | &'-' n:number { $$.value = (Value){ .c = n.i64 }; }
      | '-' ws? s:ident { $$.value = (Value){ .sub = s.charptr }; }
      | { $$.value = (Value){ .c = 0 }; }
    ) { $$.value.l = i.charptr; $$.value.reloc = r.i64; }
  |
    i:ident ws? (
      '+' ws? n:number    { $$.value = (Value){ .c = n.i64 }; }
      | &'-' n:number { $$.value = (Value){ .c = n.i64 }; }
      | '-' ws? s:ident { $$.value = (Value){ .sub = s.charptr }; }
      | { $$.value = (Value){ .c = 0 }; }
    ) { $$.value.l = i.charptr; }

const_expression =
  <'-'? [0-9a-fA-FxX]+ (ws? [+-] ws? [0-9a-fA-FxX]+)*>
  { $$.i64 = parse_const_expr(yytext); }

reloc_modifier =
    "@GOTPCRELX" { $$.i64 = R_X86_64_GOTPCRELX; }
  | "@GOTPCREL" { $$.i64 = ASM_RELOC_GOTPCREL_AUTO; }
  | "@PLT" { $$.i64 = R_X86_64_PLT32; }

ident =
    '"' <[._a-zA-Z][._a-zA-Z0-9]*> '"'
    { $$.charptr = internstring(yytext); }
  | <[._a-zA-Z][._a-zA-Z0-9]*>
    { $$.charptr = internstring(yytext); }

number =
  '-' ws? n:unsigned_number
    { $$.i64 = -n.i64; }
  | n:unsigned_number
    { $$.i64 = n.i64; }

unsigned_number =
    '0' [xX] <[0-9a-fA-F]+>
    { $$.i64 = (int64_t)strtoull(yytext, NULL, 16); }
  | <[0-9]+>
    { $$.i64 = (int64_t)strtoull(yytext, NULL, 10); }
