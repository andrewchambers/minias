line =
    ws? (
        l:label_name ws? (
            s:inline_stmt eol
            {
                Parsev first = (Parsev){ .label = (Label){ .kind = ASM_LABEL, .name = l.charptr } };
                Parsev second = s;
                $$.pair = (StmtPair){ .kind = ASM_STMT_PAIR, .first = internparsev(&first), .second = internparsev(&second) };
            }
          | eol
            { $$.label = (Label){.kind = ASM_LABEL, .name = l.charptr}; }
        )
      | s:inline_stmt eol { $$ = s; }
    )
  | eol { $$.kind = ASM_BLANK; }
  | . { $$.kind = ASM_SYNTAX_ERROR; }

ws = ([ \t]+ | comment)+
comment = "/*" ( ! "\n" ! "*/" . )* "*/"   # No support for multiline comments for now as they break our line numbers.
eolcomment = '#' (! "\n" .)+
eol = ws? (eolcomment? "\n" | ';')

inline_stmt =
    '.' d:directive { $$ = d; }
  | a:assignment { $$ = a; }
  | i:instr { $$ = i; }

assignment =
  s:ident ws? '=' ws? v:value
  { $$.set = (Set){.kind = ASM_DIR_SET, .sym = s.charptr, .value = v.value }; }

directive =
   "glob" 'o'? 'l' ws i:ident
   { $$.globl = (Globl){.kind = ASM_DIR_GLOBL, .name = i.charptr }; }
  | "global" ws i:ident
   { $$.globl = (Globl){.kind = ASM_DIR_GLOBL, .name = i.charptr }; }
  | "ascii" z:ascii_z ws s:string
    { s.kind = z.i64 ? ASM_DIR_ASCIIZ : ASM_DIR_ASCII ; $$ = s; }
  | "asciz" ws s:string
    { s.kind = ASM_DIR_ASCIIZ; $$ = s; }
  | "string" ws s:string
    { s.kind = ASM_DIR_ASCIIZ; $$ = s; }
  | "data"
    { $$.kind = ASM_DIR_DATA; }
  | "text"
    { $$.kind = ASM_DIR_TEXT; }
  | "bss"
    { $$.kind = ASM_DIR_BSS; }
  | "balign" ws n:number
    { $$.balign = (Balign){.kind = ASM_DIR_BALIGN, .align = n.i64 }; }
  | "align" ws n:number
    { $$.balign = (Balign){.kind = ASM_DIR_BALIGN, .align = n.i64 }; }
  | "p2align" ws n:number ws? ',' (! '\n' .)*
    { $$.balign = (Balign){.kind = ASM_DIR_BALIGN, .align = 1ULL << n.i64 }; }
  | "p2align" ws n:number
    { $$.balign = (Balign){.kind = ASM_DIR_BALIGN, .align = 1ULL << n.i64 }; }
  | "byte" ws v:value
    { $$.dirbyte = (Byte){.kind = ASM_DIR_BYTE, .value = v.value }; }
  | "short" ws v:value
    { $$.dirshort = (Short){.kind = ASM_DIR_SHORT, .value = v.value }; }
  | "value" ws v:value
    { $$.dirshort = (Short){.kind = ASM_DIR_SHORT, .value = v.value }; }
  | "int" ws v:value
    { $$.dirint = (Int){.kind = ASM_DIR_INT,  .value = v.value }; }
  | "long" ws v:value
    { $$.dirint = (Int){.kind = ASM_DIR_INT,  .value = v.value }; }
  | "quad" ws v:value
    { $$.dirquad = (Quad){.kind = ASM_DIR_QUAD, .value = v.value }; }
  | "set" ws s:ident ws? ',' ws? v:value
    { $$.set = (Set){.kind = ASM_DIR_SET, .sym = s.charptr, .value = v.value }; }
  | "local" ws s:ident
    { $$.weak = (Weak){.kind = ASM_DIR_LOCAL, .sym = s.charptr}; }
  | "weak" ws s:ident
    { $$.weak = (Weak){.kind = ASM_DIR_WEAK, .sym = s.charptr}; }
  | "comm" ws s:ident ws? ',' ws? z:number ws? ',' ws? a:number
    { $$.comm = (Comm){.kind = ASM_DIR_COMM, .sym = s.charptr, .size = z.i64, .align = a.i64}; }
  | "comm" ws s:ident ws? ',' ws? z:number
    { $$.comm = (Comm){.kind = ASM_DIR_COMM, .sym = s.charptr, .size = z.i64}; }
  | "file" ws number ws? ',' ws? string
    { $$.kind = ASM_BLANK; }
  | "file" ws string
    { $$.kind = ASM_BLANK; }
  | "ident" ws string
    { $$.kind = ASM_BLANK; }
  | "cfi_" [A-Za-z0-9_]+ (! '\n' .)*
    { $$.kind = ASM_BLANK; }
  | "hidden" ws i:ident
    { $$.weak = (Weak){.kind = ASM_DIR_HIDDEN, .sym = i.charptr}; }
  | "protected" ws i:ident
    { $$.weak = (Weak){.kind = ASM_DIR_PROTECTED, .sym = i.charptr}; }
  | fd:fill_directive
    { $$ = fd; }
  | sd:section_directive
    { $$ = sd; }
  | type_directive
    { $$.kind = ASM_DIR_TYPE; }
  | size_directive
    { $$.kind = ASM_DIR_SIZE; }

fill_directive =
  "fill" ws r:number ws? "," ws? s:number ws? "," ws? v:number
  { $$.fill = (Fill){ .kind=ASM_DIR_FILL, .repeat = r.i64, .size = s.i64, .value = v.i64 }; }
  | "zero" ws n:number ws? "," ws? v:number
  { $$.fill = (Fill){ .kind=ASM_DIR_FILL, .repeat = n.i64, .size = 1, .value = v.i64 }; }
  | "zero" ws n:number
  { $$.fill = (Fill){ .kind=ASM_DIR_FILL, .repeat = n.i64, .size = 1, .value = 0 }; }

section_directive =
  "section" ws? n:section_name (
      ws? ',' ws? f:section_flags ws? ',' ws? t:section_type ws? ',' ws? e:number (! '\n' .)*
      {$$.section = (DirSection){.kind=ASM_DIR_SECTION, .name=n.charptr, .flags=f.charptr, .type=t.i64, .entsize=e.i64}; }
    |
      ws? ',' ws? f:section_flags ws? ',' ws? t:section_type
      {$$.section = (DirSection){.kind=ASM_DIR_SECTION, .name=n.charptr, .flags=f.charptr, .type=t.i64}; }
    | ws? ',' ws? f:section_flags
      {$$.section = (DirSection){.kind=ASM_DIR_SECTION, .name=n.charptr, .flags=f.charptr, .type=SHT_PROGBITS}; }
    |
      {$$.section = (DirSection){.kind=ASM_DIR_SECTION, .name=n.charptr, .type=SHT_PROGBITS}; }
  )

section_name =
    n:quoted_section_name { $$ = n; }
  | n:bare_section_name { $$ = n; }
ascii_z = <'z'?> { $$.i64 = yyleng != 0; }

quoted_section_name = '"' <[._a-zA-Z0-9\-]+> '"' { $$.charptr = internstring(yytext); }
bare_section_name = <[._a-zA-Z0-9\-]+> { $$.charptr = internstring(yytext); }
section_flags = '"' <[A-Za-z]*> '"' { $$.charptr = internstring(yytext); }
section_type =
    "@nobits" { $$.i64 = SHT_NOBITS; }
  | "@progbits" { $$.i64 = SHT_PROGBITS; }

type_directive = "type" ws ident "," ws? [@%] ("function" | "object")
size_directive = "size" ws ident "," ws? (! '\n' .)*

label_name =
  i:ident ':' { $$.charptr = label_define(i.charptr); }
  | <[0-9]> ':' { $$.charptr = label_define(internstring(yytext)); }

instr =
  # Ordered by instruction frequency for performance.
  # e.g. movs are very common, so they come first.
  # The & operator means check without consuming input.
    (& 'm'
      (
          i:mov    { $$ = i; }
        | i:movabs { $$ = i; }
        | i:maxsd  { $$ = i; }
        | i:maxss  { $$ = i; }
        | i:minsd  { $$ = i; }
        | i:minss  { $$ = i; }
        | i:movsx  { $$ = i; }
        | i:movzx  { $$ = i; }
        | i:movs   { $$ = i; }
        | i:mul    { $$ = i; }
        | i:mulpd  { $$ = i; }
        | i:movaps { $$ = i; }
        | i:movups { $$ = i; }
        | i:movapd { $$ = i; }
        | i:movupd { $$ = i; }
        | i:movdqa { $$ = i; }
        | i:movdqu { $$ = i; }
        | i:movhlps { $$ = i; }
        | i:movlhps { $$ = i; }
        | i:movhpd { $$ = i; }
        | i:movhps { $$ = i; }
        | i:movlpd { $$ = i; }
        | i:movlps { $$ = i; }
        | i:movd   { $$ = i; }
        | i:movmskpd { $$ = i; }
        | i:movmskps { $$ = i; }
        | i:movq   { $$ = i; }
        | i:movsd  { $$ = i; }
        | i:movss  { $$ = i; }
        | i:mulsd  { $$ = i; }
        | i:mulss  { $$ = i; }))
  | (& 'a'
      (
          i:adc   { $$ = i; }
        | i:add   { $$ = i; }
        | i:addpd { $$ = i; }
        | i:andnps { $$ = i; }
        | i:andnpd { $$ = i; }
        | i:andps { $$ = i; }
        | i:andpd { $$ = i; }
        | i:and   { $$ = i; }
        | i:addss { $$ = i; }
        | i:addsd { $$ = i; }))
  | (& 'c'
      (
          i:cmov      { $$ = i; }
        | i:comisd    { $$ = i; }
        | i:comiss    { $$ = i; }
        | i:cmpltsd   { $$ = i; }
        | i:cmp       { $$ = i; }
        | i:cmpxchg   { $$ = i; }
        | i:call      { $$ = i; }
        | i:cld       { $$ = i; }
        | i:cvtsd2si  { $$ = i; }
        | i:cvtss2si  { $$ = i; }
        | i:cvtsi2sd  { $$ = i; }
        | i:cvtsi2ss  { $$ = i; }
        | i:cvtss2sd  { $$ = i; }
        | i:cvtsd2ss  { $$ = i; }
        | i:cvtdq2pd  { $$ = i; }
        | i:cvttpd2dq { $$ = i; }
        | i:cvttsd2si { $$ = i; }
        | i:cvttss2si { $$ = i; }
        | i:cbtw      { $$ = i; }
        | i:cwtd      { $$ = i; }
        | i:cltd      { $$ = i; }
        | i:cltq      { $$ = i; }
        | i:cwtl      { $$ = i; }
        | i:cqto      { $$ = i; }))
  | (& 's'
      (
          i:set   { $$ = i; }
        | i:sbb   { $$ = i; }
        | i:syscall { $$ = i; }
        | i:sub   { $$ = i; }
        | i:stos  { $$ = i; }
        | i:stmxcsr { $$ = i; }
        | i:std   { $$ = i; }
        | i:shufps { $$ = i; }
        | i:shufpd { $$ = i; }
        | i:sal   { $$ = i; }
        | i:sar   { $$ = i; }
        | i:shl   { $$ = i; }
        | i:shld  { $$ = i; }
        | i:shrd  { $$ = i; }
        | i:shr   { $$ = i; }
        | i:sqrtsd { $$ = i; }
        | i:sqrtss { $$ = i; }
        | i:subpd { $$ = i; }
        | i:subsd { $$ = i; }
        | i:subss { $$ = i; }))
  | (& 'x'
      (
          i:xchg  { $$ = i; }
        | i:xadd  { $$ = i; }
        | i:xor   { $$ = i; }
        | i:xorpd { $$ = i; }
        | i:xorps { $$ = i; } ))
  | (& 'o'
      (
          i:orps  { $$ = i; }
        | i:orpd  { $$ = i; }
        | i:or    { $$ = i; }
        | i:outs  { $$ = i; }
        | i:out   { $$ = i; } ))
  | (& 'b'
      (
          i:bswap { $$ = i; }
        | i:btc   { $$ = i; }
        | i:bts   { $$ = i; }
        | i:btr   { $$ = i; }
        | i:bt    { $$ = i; }
        | i:bsf   { $$ = i; }
        | i:bsr   { $$ = i; } ))
  | (& 'h'
      (
          i:hlt   { $$ = i; } ))
  | (& 'u'
      (
          i:ud2     { $$ = i; }
        | i:unpckhpd { $$ = i; }
        | i:unpckhps { $$ = i; }
        | i:unpcklpd { $$ = i; }
        | i:unpcklps { $$ = i; }
        | i:ucomisd { $$ = i; }
        | i:ucomiss { $$ = i; } ))
  | (& 'l'
      (
          i:leave   { $$ = i; }
        | i:ldmxcsr { $$ = i; }
        | i:lock    { $$ = i; }
        | i:lea     { $$ = i; } ))
  | (& 'p'
      (
          i:pause   { $$ = i; }
        | i:push    { $$ = i; }
        | i:pop     { $$ = i; }
        | i:packuswb { $$ = i; }
        | i:paddb   { $$ = i; }
        | i:paddw   { $$ = i; }
        | i:paddd   { $$ = i; }
        | i:paddq   { $$ = i; }
        | i:pand    { $$ = i; }
        | i:pandn   { $$ = i; }
        | i:pcmpeqb { $$ = i; }
        | i:pcmpeqw { $$ = i; }
        | i:pcmpeqd { $$ = i; }
        | i:pcmpgtb { $$ = i; }
        | i:pcmpgtw { $$ = i; }
        | i:pcmpgtd { $$ = i; }
        | i:pextrw  { $$ = i; }
        | i:pinsrw  { $$ = i; }
        | i:pmullw  { $$ = i; }
        | i:pmuludq { $$ = i; }
        | i:por     { $$ = i; }
        | i:psrad   { $$ = i; }
        | i:pshufd  { $$ = i; }
        | i:pshufhw { $$ = i; }
        | i:pshuflw { $$ = i; }
        | i:pslld   { $$ = i; }
        | i:psllq   { $$ = i; }
        | i:psllw   { $$ = i; }
        | i:psrld   { $$ = i; }
        | i:psrldq  { $$ = i; }
        | i:psrlq   { $$ = i; }
        | i:psrlw   { $$ = i; }
        | i:psubd   { $$ = i; }
        | i:psubq   { $$ = i; }
        | i:pxor    { $$ = i; }
        | i:punpckhbw { $$ = i; }
        | i:punpckhdq { $$ = i; }
        | i:punpckhwd { $$ = i; }
        | i:punpckhqdq { $$ = i; }
        | i:punpcklbw { $$ = i; }
        | i:punpckldq { $$ = i; }
        | i:punpcklwd { $$ = i; }
        | i:punpcklqdq { $$ = i; } ))
  | (& 'r'
      (
          i:rep   { $$ = i; }
        | i:rol   { $$ = i; }
        | i:ror   { $$ = i; }
        | i:ret   { $$ = i; } ))
  | (& 'j'
      (
          i:jmp   { $$ = i; } ))
  | (& 'd'
      (
          i:divss { $$ = i; }
        | i:divsd { $$ = i; }
        | i:div   { $$ = i; }
        | i:dec   { $$ = i; } ))
  | (& 'i'
      (
          i:idiv  { $$ = i; }
        | i:imul  { $$ = i; }
        | i:ins   { $$ = i; }
        | i:in    { $$ = i; }
        | i:inc   { $$ = i; } ))
  | (& 'n'
      (
          i:neg   { $$ = i; }
        | i:not   { $$ = i; }
        | i:nop   { $$ = i; } ))
  | (& 't'
      (
          i:test  { $$ = i; } ))
  | (& 'w'
      (
          i:wait  { $$ = i; } ))
  | (& 'e'
      (
          i:endbr32 { $$ = i; }
        | i:endbr64 { $$ = i; } ))
  # Floating point is less common, so check last.
  | (& 'f'
      (
          i:f2xm1 { $$ = i; }
        | i:fabs  { $$ = i; }
        | i:faddp { $$ = i; }
        | i:faddl { $$ = i; }
        | i:fadds { $$ = i; }
        | i:fadd  { $$ = i; }
        | i:fcompi { $$ = i; }
        | i:fcomip { $$ = i; }
        | i:fcomi { $$ = i; }
        | i:fdivl { $$ = i; }
        | i:fdivp { $$ = i; }
        | i:fdivrp { $$ = i; }
        | i:fdivrl { $$ = i; }
        | i:fdivs { $$ = i; }
        | i:fdivr { $$ = i; }
        | i:fdiv  { $$ = i; }
        | i:fiaddl { $$ = i; }
        | i:fidivl { $$ = i; }
        | i:fidivrl { $$ = i; }
        | i:fimull { $$ = i; }
        | i:fisubl { $$ = i; }
        | i:fisubrl { $$ = i; }
        | i:fildll { $$ = i; }
        | i:fildl { $$ = i; }
        | i:fildq { $$ = i; }
        | i:fistl { $$ = i; }
        | i:fistpll { $$ = i; }
        | i:fistpl { $$ = i; }
        | i:fistpq { $$ = i; }
        | i:fisttpll { $$ = i; }
        | i:fldcw { $$ = i; }
        | i:fldenv { $$ = i; }
        | i:fld1  { $$ = i; }
        | i:fldl2e { $$ = i; }
        | i:fldlg2 { $$ = i; }
        | i:fldln2 { $$ = i; }
        | i:fldz  { $$ = i; }
        | i:fldl  { $$ = i; }
        | i:flds  { $$ = i; }
        | i:fld   { $$ = i; }
        | i:fnclex { $$ = i; }
        | i:fnstcw { $$ = i; }
        | i:fnstenv { $$ = i; }
        | i:fnstsw { $$ = i; }
        | i:fstcw { $$ = i; }
        | i:fprem1 { $$ = i; }
        | i:fprem { $$ = i; }
        | i:fsts  { $$ = i; }
        | i:fstl  { $$ = i; }
        | i:fstpl { $$ = i; }
        | i:fstps { $$ = i; }
        | i:fstpt { $$ = i; }
        | i:fstp  { $$ = i; }
        | i:fpatan { $$ = i; }
        | i:fcmov { $$ = i; }
        | i:fchs  { $$ = i; }
        | i:fmulp { $$ = i; }
        | i:fmull { $$ = i; }
        | i:fmuls { $$ = i; }
        | i:fmul  { $$ = i; }
        | i:frndint { $$ = i; }
        | i:fscale { $$ = i; }
        | i:fsqrt { $$ = i; }
        | i:fsubrp { $$ = i; }
        | i:fsubp { $$ = i; }
        | i:fsubrs { $$ = i; }
        | i:fsubr { $$ = i; }
        | i:fsubl { $$ = i; }
        | i:fsubs { $$ = i; }
        | i:fsub  { $$ = i; }
        | i:fucompi { $$ = i; }
        | i:fucomip { $$ = i; }
        | i:fucomi { $$ = i; }
        | i:fyl2xp1 { $$ = i; }
        | i:fyl2x { $$ = i; }
        | i:fxch  { $$ = i; }))

call = "call" 'q'? ws (
    '*' t:mem
      { $$ = OPMEM({.w=0}, -1, 0xff, 0x02, t); }
  | '*' t:r64
      { $$ = OPREG({.w=0}, -1, 0xff, 0x02, t); }
  | t:local_label_ref
      { Parsev ma = (Parsev){.memarg = (Memarg) {.kind=ASM_MEMARG, .disp = (Value){.l = t.charptr} }};
        $$ = RELCALL({.w=0}, -1, 0xe8, ma); }
  | t:value
      { Parsev ma = (Parsev){.memarg = (Memarg) {.kind=ASM_MEMARG, .disp = t.value }};
        $$ = RELCALL({.w=0}, -1, 0xe8, ma); }
)

jmp = "jmp" 'q'? ws '*' t:mem
      { $$ = OPMEM({.w=0}, -1, 0xff, 0x04, t); }
  | "jmp" 'q'? ws '*' t:r64
      { $$ = OPREG({.w=0}, -1, 0xff, 0x04, t); }
  | 'j' v:jmp_variant ws t:branch_target
    { $$.jmp = (Jmp) {.kind = ASM_JMP, .cc=v.i64, .target=t.value.l, .reloc=t.value.reloc}; }

branch_target =
    i:local_label_ref
    { $$.value = (Value){ .l = i.charptr }; }
  | i:ident "@PLT"
    { $$.value = (Value){ .l = i.charptr, .reloc = R_X86_64_PLT32 }; }
  | i:ident
    { $$.value = (Value){ .l = i.charptr }; }

local_label_digit = <[0-9]> { $$.charptr = internstring(yytext); }
local_label_dir = <[fb]> { $$.charptr = internstring(yytext); }
local_label_ref = n:local_label_digit d:local_label_dir
  { $$.charptr = local_label_reference(n.charptr, d.charptr); }

jmp_variant =
      "mp"  { $$.i64 = 0; }
    | cc:condition_code { $$.i64 = cc.i64 + 1;}

condition_code =
      "z"   { $$.i64 = 0; }
    | "s"   { $$.i64 = 1; }
    | "po"  { $$.i64 = 2; }
    | "pe"  { $$.i64 = 3; }
    | "p"   { $$.i64 = 4; }
    | "o"   { $$.i64 = 5; }
    | ("n"
        (
            "z"  { $$.i64 = 6; }
          | "s"  { $$.i64 = 7; }
          | "p"  { $$.i64 = 8; }
          | "o"  { $$.i64 = 9; }
          | "le" { $$.i64 = 10; }
          | "l"  { $$.i64 = 11; }
          | "ge" { $$.i64 = 12; }
          | "g"  { $$.i64 = 13; }
          | "e"  { $$.i64 = 14; }
          | "c"  { $$.i64 = 15; }
          | "be" { $$.i64 = 16; }
          | "b"  { $$.i64 = 17; }
          | "ae" { $$.i64 = 18; }
          | "a"  { $$.i64 = 19; }))
    | "le"  { $$.i64 = 20; }
    | "l"   { $$.i64 = 21; }
    | "ge"  { $$.i64 = 22; }
    | "g"   { $$.i64 = 23; }
    | "e"   { $$.i64 = 24; }
    | "c"   { $$.i64 = 25; }
    | "be"  { $$.i64 = 26; }
    | "b"   { $$.i64 = 27; }
    | "ae"  { $$.i64 = 28; }
    | "a"   { $$.i64 = 29; }


cbtw =  "cbtw"  { $$ = OP(0x01006698); }
cwtd =  "cwtd"  { $$ = OP(0x01006699); }
cltd =  "cltd"  { $$ = OP(0x99); }
cltq =  "cltq"  { $$ = OP(0x01004898); }
cwtl =  "cwtl"  { $$ = OP(0x98); }
cqto =  "cqto"  { $$ = OP(0x01004899); }
cld = "cld" { $$ = OP(0xfc); }
std = "std" { $$ = OP(0xfd); }
syscall = "syscall" { $$ = OP(0x01000f05); }
leave = "leave" { $$ = OP(0xc9); }
hlt = "hlt" { $$ = OP(0xf4); }
ud2 = "ud2" { $$ = OP(0x01000f0b); }
pause = "pause" { $$ = OP(0x0100f390); }
nop =   "nop"   { $$ = OP(0x90); }
ret =  "ret" 'q'? { $$ = OP(0xc3); }
wait = "wait" { $$ = OP(0x9b); }

rep = "rep" (
    ws? ';'? ws? "bsf" (
        'l'? ws s:r32 ws? ',' ws? d:r32 { $$ = REGREG2({.w=0}, 0xf3, 0x01000fbc, s, d); }
      | 'q'? ws s:r64 ws? ',' ws? d:r64 { $$ = REGREG2({.w=1}, 0xf3, 0x01000fbc, s, d); }
      | 'l'  ws s:mem ws? ',' ws? d:r32 { $$ = MEMREG({.w=0}, 0xf3, 0x01000fbc, s, d); }
      | 'q'  ws s:mem ws? ',' ws? d:r64 { $$ = MEMREG({.w=1}, 0xf3, 0x01000fbc, s, d); }
    )
  |
    ws? ';'? ws? (
        "ret"   { $$ = OP(0x0100f3c3); }
      | "movsb" (
          s:movs_operands { $$ = OPP(0xf3, stringopcode(s.i64, 0xa4)); }
        | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
        | { $$ = OPP(0xf3, 0xa4); }
      )
      | "movsw" (
          s:movs_operands { $$ = OPP(0xf3, stringopcode(s.i64, 0x010066a5)); }
        | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
        | { $$ = OPP(0xf3, 0x010066a5); }
      )
      | "movsl" (
          s:movs_operands { $$ = OPP(0xf3, stringopcode(s.i64, 0xa5)); }
        | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
        | { $$ = OPP(0xf3, 0xa5); }
      )
      | "movsq" (
          s:movs_operands { $$ = OPP(0xf3, stringopcode(s.i64, 0x010048a5)); }
        | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
        | { $$ = OPP(0xf3, 0x010048a5); }
      )
      | "stosb" (
          stosb_operands { $$ = OP(0x0100f3aa); }
        | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
        | { $$ = OP(0x0100f3aa); }
      )
      | "stosw" (
          stosw_operands { $$ = OP(0x02f366ab); }
        | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
        | { $$ = OP(0x02f366ab); }
      )
      | "stosl" (
          stosl_operands { $$ = OP(0x0100f3ab); }
        | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
        | { $$ = OP(0x0100f3ab); }
      )
      | "stosq" (
          stosq_operands { $$ = OP(0x02f348ab); }
        | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
        | { $$ = OP(0x02f348ab); }
      )
      | "outsb" { $$ = OPP(0xf3, 0x6e); }
      | "outsw" { $$ = OPP(0xf3, 0x0100666f); }
      | "outsl" { $$ = OPP(0xf3, 0x6f); }
      | "insb"  { $$ = OPP(0xf3, 0x6c); }
      | "insw"  { $$ = OPP(0xf3, 0x0100666d); }
      | "insl"  { $$ = OPP(0xf3, 0x6d); }
    )
  | { $$ = OP(0xf3); }
)

movs_operands = ws s:string_src ws? ',' ws? string_dst { $$ = s; }
stosb_operands = ws ("%al"  ws? ',' ws?)? string_dst
stosw_operands = ws ("%ax"  ws? ',' ws?)? string_dst
stosl_operands = ws ("%eax" ws? ',' ws?)? string_dst
stosq_operands = ws ("%rax" ws? ',' ws?)? string_dst

string_src = s:string_src_segment '(' ws? "%rsi" ws? ')' { $$ = s; }
string_src_segment =
    "%cs:" { $$.i64 = 0x2e; }
  | "%ss:" { $$.i64 = 0x36; }
  | "%es:" { $$.i64 = 0x26; }
  | "%fs:" { $$.i64 = 0x64; }
  | "%gs:" { $$.i64 = 0x65; }
  | "%ds:" { $$.i64 = -1; }
  | { $$.i64 = -1; }
string_dst = "%es:"? '(' ws? "%rdi" ws? ')'
invalid_string_operands = ws ![#\n;] (!'\n' !';' .)+

movs = "movs" (
    "b" (
        s:movs_operands { $$ = OPP(-1, stringopcode(s.i64, 0xa4)); }
      | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
      | { $$ = OP(0xa4); }
    )
  | "w" (
        s:movs_operands { $$ = OPP(-1, stringopcode(s.i64, 0x010066a5)); }
      | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
      | { $$ = OP(0x010066a5); }
    )
  | "l" (
        s:movs_operands { $$ = OPP(-1, stringopcode(s.i64, 0xa5)); }
      | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
      | { $$ = OP(0xa5); }
    )
  | "q" (
        s:movs_operands { $$ = OPP(-1, stringopcode(s.i64, 0x010048a5)); }
      | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
      | { $$ = OP(0x010048a5); }
    )
)

stos = "stos" (
    "b" (
        stosb_operands { $$ = OP(0xaa); }
      | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
      | { $$ = OP(0xaa); }
    )
  | "w" (
        stosw_operands { $$ = OP(0x010066ab); }
      | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
      | { $$ = OP(0x010066ab); }
    )
  | "l" (
        stosl_operands { $$ = OP(0xab); }
      | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
      | { $$ = OP(0xab); }
    )
  | "q" (
        stosq_operands { $$ = OP(0x010048ab); }
      | invalid_string_operands { $$ = INVALID_STRING_OPERANDS; }
      | { $$ = OP(0x010048ab); }
    )
)

out = "out" (
    'b' ws "%al"  ws? ',' ws? "%dx" { $$ = OP(0xee); }
  | 'w' ws "%ax"  ws? ',' ws? "%dx" { $$ = OP(0x010066ef); }
  | 'l' ws "%eax" ws? ',' ws? "%dx" { $$ = OP(0xef); }
)

in = "in" (
    'b' ws "%dx" ws? ',' ws? "%al"  { $$ = OP(0xec); }
  | 'w' ws "%dx" ws? ',' ws? "%ax"  { $$ = OP(0x010066ed); }
  | 'l' ws "%dx" ws? ',' ws? "%eax" { $$ = OP(0xed); }
)

outs = "outs" (
    'b' { $$ = OP(0x6e); }
  | 'w' { $$ = OP(0x0100666f); }
  | 'l' { $$ = OP(0x6f); }
)

ins = "ins" (
    'b' { $$ = OP(0x6c); }
  | 'w' { $$ = OP(0x0100666d); }
  | 'l' { $$ = OP(0x6d); }
)

stmxcsr = "stmxcsr" ws d:mem
  { $$ = OPMEM({.w=0}, -1, 0x01000fae, 0x03, d); }

ldmxcsr = "ldmxcsr" ws d:mem
  { $$ = OPMEM({.w=0}, -1, 0x01000fae, 0x02, d); }

shufps = "shufps" (
    ws i:imm8 ws? ',' ws? s:xmm ws? ',' ws? d:xmm { $$ = IMMREGREG2({.w=0}, -1, 0x01000fc6, i, s, d); }
  | ws i:imm8 ws? ',' ws? s:mem ws? ',' ws? d:xmm { $$ = IMMMEMREG({.w=0}, -1, 0x01000fc6, i, s, d); }
)

shufpd = "shufpd" (
    ws i:imm8 ws? ',' ws? s:xmm ws? ',' ws? d:xmm { $$ = IMMREGREG2({.w=0}, 0x66, 0x01000fc6, i, s, d); }
  | ws i:imm8 ws? ',' ws? s:mem ws? ',' ws? d:xmm { $$ = IMMMEMREG({.w=0}, 0x66, 0x01000fc6, i, s, d); }
)

cmpltsd = "cmpltsd" (
    ws s:xmm ws? ',' ws? d:xmm {
      Parsev i = (Parsev){.imm = (Imm){.kind=ASM_IMM, .v={.c=1}, .nbytes=1}};
      $$ = IMMREGREG2({.w=0}, 0xf2, 0x01000fc2, i, s, d);
    }
  | ws s:mem ws? ',' ws? d:xmm {
      Parsev i = (Parsev){.imm = (Imm){.kind=ASM_IMM, .v={.c=1}, .nbytes=1}};
      $$ = IMMMEMREG({.w=0}, 0xf2, 0x01000fc2, i, s, d);
    }
)

cvtdq2pd = "cvtdq2pd" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0xf3, 0x01000fe6, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG({.w=0}, 0xf3, 0x01000fe6, s, d); }
)

pshufd = "pshufd" (
    ws i:imm8 ws? ',' ws? s:xmm ws? ',' ws? d:xmm { $$ = IMMREGREG2({.w=0}, 0x66, 0x01000f70, i, s, d); }
  | ws i:imm8 ws? ',' ws? s:mem ws? ',' ws? d:xmm { $$ = IMMMEMREG({.w=0}, 0x66, 0x01000f70, i, s, d); }
)

pshuflw = "pshuflw" (
    ws i:imm8 ws? ',' ws? s:xmm ws? ',' ws? d:xmm { $$ = IMMREGREG2({.w=0}, 0xf2, 0x01000f70, i, s, d); }
  | ws i:imm8 ws? ',' ws? s:mem ws? ',' ws? d:xmm { $$ = IMMMEMREG({.w=0}, 0xf2, 0x01000f70, i, s, d); }
)

pshufhw = "pshufhw" (
    ws i:imm8 ws? ',' ws? s:xmm ws? ',' ws? d:xmm { $$ = IMMREGREG2({.w=0}, 0xf3, 0x01000f70, i, s, d); }
  | ws i:imm8 ws? ',' ws? s:mem ws? ',' ws? d:xmm { $$ = IMMMEMREG({.w=0}, 0xf3, 0x01000f70, i, s, d); }
)

psrlw = "psrlw" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000fd1, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG({.w=0}, 0x66, 0x01000fd1, s, d); }
  | ws i:imm8 ws? ',' ws? d:xmm { $$ = IMMREG({.w=0}, 0x66, 0x01000f71, 0x02, i, d); }
)

psrld = "psrld" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000fd2, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG({.w=0}, 0x66, 0x01000fd2, s, d); }
  | ws i:imm8 ws? ',' ws? d:xmm { $$ = IMMREG({.w=0}, 0x66, 0x01000f72, 0x02, i, d); }
)

psrlq = "psrlq" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000fd3, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG({.w=0}, 0x66, 0x01000fd3, s, d); }
  | ws i:imm8 ws? ',' ws? d:xmm { $$ = IMMREG({.w=0}, 0x66, 0x01000f73, 0x02, i, d); }
)

psrad = "psrad" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000fe2, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG({.w=0}, 0x66, 0x01000fe2, s, d); }
  | ws i:imm8 ws? ',' ws? d:xmm { $$ = IMMREG({.w=0}, 0x66, 0x01000f72, 0x04, i, d); }
)

psrldq = "psrldq" (
    ws i:imm8 ws? ',' ws? d:xmm { $$ = IMMREG({.w=0}, 0x66, 0x01000f73, 0x03, i, d); }
)

psllw = "psllw" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000ff1, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG({.w=0}, 0x66, 0x01000ff1, s, d); }
  | ws i:imm8 ws? ',' ws? d:xmm { $$ = IMMREG({.w=0}, 0x66, 0x01000f71, 0x06, i, d); }
)

pslld = "pslld" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000ff2, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG({.w=0}, 0x66, 0x01000ff2, s, d); }
  | ws i:imm8 ws? ',' ws? d:xmm { $$ = IMMREG({.w=0}, 0x66, 0x01000f72, 0x06, i, d); }
)

psllq = "psllq" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000ff3, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG({.w=0}, 0x66, 0x01000ff3, s, d); }
  | ws i:imm8 ws? ',' ws? d:xmm { $$ = IMMREG({.w=0}, 0x66, 0x01000f73, 0x06, i, d); }
)

bsf = "bsf" (
    'l'? ws s:r32 ws? ',' ws? d:r32 { $$ = REGREG2({.w=0}, -1, 0x01000fbc, s, d); }
  | 'q'? ws s:r64 ws? ',' ws? d:r64 { $$ = REGREG2({.w=1}, -1, 0x01000fbc, s, d); }
  | 'l'  ws s:mem ws? ',' ws? d:r32 { $$ = MEMREG({.w=0}, -1, 0x01000fbc, s, d); }
  | 'q'  ws s:mem ws? ',' ws? d:r64 { $$ = MEMREG({.w=1}, -1, 0x01000fbc, s, d); }
)

bsr = "bsr" (
    'l'? ws s:r32 ws? ',' ws? d:r32 { $$ = REGREG2({.w=0}, -1, 0x01000fbd, s, d); }
  | 'q'? ws s:r64 ws? ',' ws? d:r64 { $$ = REGREG2({.w=1}, -1, 0x01000fbd, s, d); }
  | 'l'  ws s:mem ws? ',' ws? d:r32 { $$ = MEMREG({.w=0}, -1, 0x01000fbd, s, d); }
  | 'q'  ws s:mem ws? ',' ws? d:r64 { $$ = MEMREG({.w=1}, -1, 0x01000fbd, s, d); }
)

btr = "btr" (
    'w'? ws i:imm8 ws? ',' ws? d:r16 { $$ = IMMREG({.w=0}, 0x66, 0x01000fba, 0x06, i, d); }
  | 'l'? ws i:imm8 ws? ',' ws? d:r32 { $$ = IMMREG({.w=0},   -1, 0x01000fba, 0x06, i, d); }
  | 'q'? ws i:imm8 ws? ',' ws? d:r64 { $$ = IMMREG({.w=1},   -1, 0x01000fba, 0x06, i, d); }
  | 'w'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=0}, 0x66, 0x01000fba, 0x06, i, d); }
  | 'l'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=0},   -1, 0x01000fba, 0x06, i, d); }
  | 'q'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=1},   -1, 0x01000fba, 0x06, i, d); }

  | 'w'? ws s:r16 ws? ',' ws? d:r16 { $$ = REGREG({.w=0}, 0x66, 0x01000fb3, s, d); }
  | 'l'? ws s:r32 ws? ',' ws? d:r32 { $$ = REGREG({.w=0},   -1, 0x01000fb3, s, d); }
  | 'q'? ws s:r64 ws? ',' ws? d:r64 { $$ = REGREG({.w=1},   -1, 0x01000fb3, s, d); }
  | 'w'  ws s:r16 ws? ',' ws? d:mem { $$ = REGMEM({.w=0}, 0x66, 0x01000fb3, s, d); }
  | 'l'  ws s:r32 ws? ',' ws? d:mem { $$ = REGMEM({.w=0},   -1, 0x01000fb3, s, d); }
  | 'q'  ws s:r64 ws? ',' ws? d:mem { $$ = REGMEM({.w=1},   -1, 0x01000fb3, s, d); }
)

bts = "bts" (
    'w'? ws i:imm8 ws? ',' ws? d:r16 { $$ = IMMREG({.w=0}, 0x66, 0x01000fba, 0x05, i, d); }
  | 'l'? ws i:imm8 ws? ',' ws? d:r32 { $$ = IMMREG({.w=0},   -1, 0x01000fba, 0x05, i, d); }
  | 'q'? ws i:imm8 ws? ',' ws? d:r64 { $$ = IMMREG({.w=1},   -1, 0x01000fba, 0x05, i, d); }
  | 'w'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=0}, 0x66, 0x01000fba, 0x05, i, d); }
  | 'l'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=0},   -1, 0x01000fba, 0x05, i, d); }
  | 'q'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=1},   -1, 0x01000fba, 0x05, i, d); }

  | 'w'? ws s:r16 ws? ',' ws? d:r16 { $$ = REGREG({.w=0}, 0x66, 0x01000fab, s, d); }
  | 'l'? ws s:r32 ws? ',' ws? d:r32 { $$ = REGREG({.w=0},   -1, 0x01000fab, s, d); }
  | 'q'? ws s:r64 ws? ',' ws? d:r64 { $$ = REGREG({.w=1},   -1, 0x01000fab, s, d); }
  | 'w'  ws s:r16 ws? ',' ws? d:mem { $$ = REGMEM({.w=0}, 0x66, 0x01000fab, s, d); }
  | 'l'  ws s:r32 ws? ',' ws? d:mem { $$ = REGMEM({.w=0},   -1, 0x01000fab, s, d); }
  | 'q'  ws s:r64 ws? ',' ws? d:mem { $$ = REGMEM({.w=1},   -1, 0x01000fab, s, d); }
)

btc = "btc" (
    'w'? ws i:imm8 ws? ',' ws? d:r16 { $$ = IMMREG({.w=0}, 0x66, 0x01000fba, 0x07, i, d); }
  | 'l'? ws i:imm8 ws? ',' ws? d:r32 { $$ = IMMREG({.w=0},   -1, 0x01000fba, 0x07, i, d); }
  | 'q'? ws i:imm8 ws? ',' ws? d:r64 { $$ = IMMREG({.w=1},   -1, 0x01000fba, 0x07, i, d); }
  | 'w'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=0}, 0x66, 0x01000fba, 0x07, i, d); }
  | 'l'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=0},   -1, 0x01000fba, 0x07, i, d); }
  | 'q'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=1},   -1, 0x01000fba, 0x07, i, d); }

  | 'w'? ws s:r16 ws? ',' ws? d:r16 { $$ = REGREG({.w=0}, 0x66, 0x01000fbb, s, d); }
  | 'l'? ws s:r32 ws? ',' ws? d:r32 { $$ = REGREG({.w=0},   -1, 0x01000fbb, s, d); }
  | 'q'? ws s:r64 ws? ',' ws? d:r64 { $$ = REGREG({.w=1},   -1, 0x01000fbb, s, d); }
  | 'w'  ws s:r16 ws? ',' ws? d:mem { $$ = REGMEM({.w=0}, 0x66, 0x01000fbb, s, d); }
  | 'l'  ws s:r32 ws? ',' ws? d:mem { $$ = REGMEM({.w=0},   -1, 0x01000fbb, s, d); }
  | 'q'  ws s:r64 ws? ',' ws? d:mem { $$ = REGMEM({.w=1},   -1, 0x01000fbb, s, d); }
)

bt = "bt" (
    'w'? ws s:r16 ws? ',' ws? d:r16 { $$ = REGREG({.w=0}, 0x66, 0x01000fa3, s, d); }
  | 'l'? ws s:r32 ws? ',' ws? d:r32 { $$ = REGREG({.w=0},   -1, 0x01000fa3, s, d); }
  | 'q'? ws s:r64 ws? ',' ws? d:r64 { $$ = REGREG({.w=1},   -1, 0x01000fa3, s, d); }
  | 'w'  ws s:r16 ws? ',' ws? d:mem { $$ = REGMEM({.w=0}, 0x66, 0x01000fa3, s, d); }
  | 'l'  ws s:r32 ws? ',' ws? d:mem { $$ = REGMEM({.w=0},   -1, 0x01000fa3, s, d); }
  | 'q'  ws s:r64 ws? ',' ws? d:mem { $$ = REGMEM({.w=1},   -1, 0x01000fa3, s, d); }
  | 'w'? ws i:imm8 ws? ',' ws? d:r16 { $$ = IMMREG({.w=0}, 0x66, 0x01000fba, 0x04, i, d); }
  | 'l'? ws i:imm8 ws? ',' ws? d:r32 { $$ = IMMREG({.w=0},   -1, 0x01000fba, 0x04, i, d); }
  | 'q'? ws i:imm8 ws? ',' ws? d:r64 { $$ = IMMREG({.w=1},   -1, 0x01000fba, 0x04, i, d); }
  | 'w'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=0}, 0x66, 0x01000fba, 0x04, i, d); }
  | 'l'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=0},   -1, 0x01000fba, 0x04, i, d); }
  | 'q'  ws i:imm8 ws? ',' ws? d:mem { $$ = IMMMEM({.w=1},   -1, 0x01000fba, 0x04, i, d); }
)

bswap = "bswap" (
    'l'? ws d:r32 { $$ = R({.w=0}, -1, 0x01000fc8, d); }
  | 'q'? ws d:r64 { $$ = R({.w=1}, -1, 0x01000fc8, d); }
)

endbr64 = "endbr64" { $$ = OPP(0xf3, 0x020f1efa); }
endbr32 = "endbr32" { $$ = OPP(0xf3, 0x020f1efb); }

push = "push" (
    'q'? ws  s:r64 { $$ = R({.w=0}, -1, 0x50, s); }
  | 'q'? ws  s:imm32_8 { $$ = IMM({.w=0}, -1, s.imm.nbytes == 1 ? 0x6a : 0x68, s, s); }
  | 'q'  ws  s:mem { $$ = OPMEM({.w=0}, -1, 0xff, 0x06, s); }
)

pop = "pop" (
    'q'? ws d:r64 { $$ = R({.w=0}, -1, 0x58, d); }
  | 'q'  ws d:mem { $$ = OPMEM({.w=0}, -1, 0x8f, 0x00, d); }
)

div = "div" (
    'b'? ws a:r8  { $$ = OPREG({.w=0},   -1, 0xf6, 0x06, a); }
  | 'w'? ws a:r16 { $$ = OPREG({.w=0}, 0x66, 0xf7, 0x06, a); }
  | 'l'? ws a:r32 { $$ = OPREG({.w=0},   -1, 0xf7, 0x06, a); }
  | 'q'? ws a:r64 { $$ = OPREG({.w=1},   -1, 0xf7, 0x06, a); }
  | 'b'  ws a:mem { $$ = OPMEM({.w=0},   -1, 0xf6, 0x06, a); }
  | 'w'  ws a:mem { $$ = OPMEM({.w=0}, 0x66, 0xf7, 0x06, a); }
