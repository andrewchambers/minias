  | 'w'? ws i:imm8 ws? ',' ws? d:r16 { $$ = IMMREG({.w=0}, 0x66, 0xc1, 0x05, i, d); }
  | 'l'? ws i:imm8 ws? ',' ws? d:r32 { $$ = IMMREG({.w=0},   -1, 0xc1, 0x05, i, d); }
