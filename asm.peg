  | 'q'  ws d:mem { $$ = OPMEM({.w=1},   -1, 0xd1, 0x01, d); }
  | 'b'? ws d:r8  { $$ = OPREG({.w=0},   -1, 0xd0, 0x01, d); }
  | 'w'? ws d:r16 { $$ = OPREG({.w=0}, 0x66, 0xd1, 0x01, d); }
  | 'l'? ws d:r32 { $$ = OPREG({.w=0},   -1, 0xd1, 0x01, d); }
  | 'q'? ws d:r64 { $$ = OPREG({.w=1},   -1, 0xd1, 0x01, d); }
)

shrd = "shrd" (
    'w'? ws c:cl ws? ',' ws? s:r16 ws? ',' ws? d:r16 { $$ = REGREG({.w=0}, 0x66, 0x01000fad, s, d); }
  | 'l'? ws c:cl ws? ',' ws? s:r32 ws? ',' ws? d:r32 { $$ = REGREG({.w=0},   -1, 0x01000fad, s, d); }
  | 'q'? ws c:cl ws? ',' ws? s:r64 ws? ',' ws? d:r64 { $$ = REGREG({.w=1},   -1, 0x01000fad, s, d); }
  | 'w'  ws c:cl ws? ',' ws? s:r16 ws? ',' ws? d:mem { $$ = REGMEM({.w=0}, 0x66, 0x01000fad, s, d); }
  | 'l'  ws c:cl ws? ',' ws? s:r32 ws? ',' ws? d:mem { $$ = REGMEM({.w=0},   -1, 0x01000fad, s, d); }
  | 'q'  ws c:cl ws? ',' ws? s:r64 ws? ',' ws? d:mem { $$ = REGMEM({.w=1},   -1, 0x01000fad, s, d); }
  | 'w'? ws i:imm8 ws? ',' ws? s:r16 ws? ',' ws? d:r16 { $$ = IMMREGREG2({.w=0}, 0x66, 0x01000fac, i, d, s); }
  | 'l'? ws i:imm8 ws? ',' ws? s:r32 ws? ',' ws? d:r32 { $$ = IMMREGREG2({.w=0},   -1, 0x01000fac, i, d, s); }
  | 'q'? ws i:imm8 ws? ',' ws? s:r64 ws? ',' ws? d:r64 { $$ = IMMREGREG2({.w=1},   -1, 0x01000fac, i, d, s); }
  | 'w'  ws i:imm8 ws? ',' ws? s:r16 ws? ',' ws? d:mem { $$ = IMMMEMREG({.w=0}, 0x66, 0x01000fac, i, d, s); }
  | 'l'  ws i:imm8 ws? ',' ws? s:r32 ws? ',' ws? d:mem { $$ = IMMMEMREG({.w=0},   -1, 0x01000fac, i, d, s); }
  | 'q'  ws i:imm8 ws? ',' ws? s:r64 ws? ',' ws? d:mem { $$ = IMMMEMREG({.w=1},   -1, 0x01000fac, i, d, s); }
)

shld = "shld" (
    'w'? ws c:cl ws? ',' ws? s:r16 ws? ',' ws? d:r16 { $$ = REGREG({.w=0}, 0x66, 0x01000fa5, s, d); }
  | 'l'? ws c:cl ws? ',' ws? s:r32 ws? ',' ws? d:r32 { $$ = REGREG({.w=0},   -1, 0x01000fa5, s, d); }
  | 'q'? ws c:cl ws? ',' ws? s:r64 ws? ',' ws? d:r64 { $$ = REGREG({.w=1},   -1, 0x01000fa5, s, d); }
  | 'w'  ws c:cl ws? ',' ws? s:r16 ws? ',' ws? d:mem { $$ = REGMEM({.w=0}, 0x66, 0x01000fa5, s, d); }
  | 'l'  ws c:cl ws? ',' ws? s:r32 ws? ',' ws? d:mem { $$ = REGMEM({.w=0},   -1, 0x01000fa5, s, d); }
  | 'q'  ws c:cl ws? ',' ws? s:r64 ws? ',' ws? d:mem { $$ = REGMEM({.w=1},   -1, 0x01000fa5, s, d); }
  | 'w'? ws i:imm8 ws? ',' ws? s:r16 ws? ',' ws? d:r16 { $$ = IMMREGREG2({.w=0}, 0x66, 0x01000fa4, i, d, s); }
  | 'l'? ws i:imm8 ws? ',' ws? s:r32 ws? ',' ws? d:r32 { $$ = IMMREGREG2({.w=0},   -1, 0x01000fa4, i, d, s); }
  | 'q'? ws i:imm8 ws? ',' ws? s:r64 ws? ',' ws? d:r64 { $$ = IMMREGREG2({.w=1},   -1, 0x01000fa4, i, d, s); }
  | 'w'  ws i:imm8 ws? ',' ws? s:r16 ws? ',' ws? d:mem { $$ = IMMMEMREG({.w=0}, 0x66, 0x01000fa4, i, d, s); }
  | 'l'  ws i:imm8 ws? ',' ws? s:r32 ws? ',' ws? d:mem { $$ = IMMMEMREG({.w=0},   -1, 0x01000fa4, i, d, s); }
  | 'q'  ws i:imm8 ws? ',' ws? s:r64 ws? ',' ws? d:mem { $$ = IMMMEMREG({.w=1},   -1, 0x01000fa4, i, d, s); }
)

test = "test" (
    'b'? ws s:r8  ws? ',' ws? d:r8  { $$ = REGREG({.w=0},   -1, 0x84, s, d); }
  | 'w'? ws s:r16 ws? ',' ws? d:r16 { $$ = REGREG({.w=0}, 0x66, 0x85, s, d); }
  | 'l'? ws s:r32 ws? ',' ws? d:r32 { $$ = REGREG({.w=0},   -1, 0x85, s, d); }
  | 'q'? ws s:r64 ws? ',' ws? d:r64 { $$ = REGREG({.w=1},   -1, 0x85, s, d); }

  | 'b'? ws s:r8  ws? ',' ws? d:mem { $$ = REGMEM({.w=0},   -1, 0x84, s, d); }
  | 'w'? ws s:r16 ws? ',' ws? d:mem { $$ = REGMEM({.w=0}, 0x66, 0x85, s, d); }
  | 'l'? ws s:r32 ws? ',' ws? d:mem { $$ = REGMEM({.w=0},   -1, 0x85, s, d); }
  | 'q'? ws s:r64 ws? ',' ws? d:mem { $$ = REGMEM({.w=1},   -1, 0x85, s, d); }

  | 'b'? ws s:mem ws? ',' ws? d:r8  { $$ = MEMREG({.w=0},   -1, 0x84, s, d); }
  | 'w'? ws s:mem ws? ',' ws? d:r16 { $$ = MEMREG({.w=0}, 0x66, 0x85, s, d); }
  | 'l'? ws s:mem ws? ',' ws? d:r32 { $$ = MEMREG({.w=0},   -1, 0x85, s, d); }
  | 'q'? ws s:mem ws? ',' ws? d:r64 { $$ = MEMREG({.w=1},   -1, 0x85, s, d); }

  | 'b'? ws s:imm8  ws? ',' ws? d:al  { $$ = IMM({.w=0},   -1, 0xa8, s, d); }
  | 'w'? ws s:imm16 ws? ',' ws? d:ax  { $$ = IMM({.w=0}, 0x66, 0xa9, s, d); }
  | 'l'? ws s:imm32 ws? ',' ws? d:eax { $$ = IMM({.w=0},   -1, 0xa9, s, d); }
  | 'q'? ws s:imm32 ws? ',' ws? d:rax { $$ = IMM({.w=1},   -1, 0xa9, s, d); }

  | 'b'? ws s:imm8  ws? ',' ws? d:r8  { $$ = IMMREG({.w=0},   -1, 0xf6, 0x00, s, d); }
  | 'w'? ws s:imm16 ws? ',' ws? d:r16 { $$ = IMMREG({.w=0}, 0x66, 0xf7, 0x00, s, d); }
  | 'l'? ws s:imm32 ws? ',' ws? d:r32 { $$ = IMMREG({.w=0},   -1, 0xf7, 0x00, s, d); }
  | 'q'? ws s:imm32 ws? ',' ws? d:r64 { $$ = IMMREG({.w=1},   -1, 0xf7, 0x00, s, d); }

  | 'b'  ws s:imm8  ws? ',' ws? d:mem { $$ = IMMMEM({.w=0},   -1, 0xf6, 0x00, s, d); }
  | 'w'  ws s:imm16 ws? ',' ws? d:mem { $$ = IMMMEM({.w=0}, 0x66, 0xf7, 0x00, s, d); }
  | 'l'  ws s:imm32 ws? ',' ws? d:mem { $$ = IMMMEM({.w=0},   -1, 0xf7, 0x00, s, d); }
  | 'q'  ws s:imm32 ws? ',' ws? d:mem { $$ = IMMMEM({.w=1},   -1, 0xf7, 0x00, s, d); }
)

# Floating point instructions.

f2xm1 = "f2xm1"
  { $$ = OP(0x0100d9f0); }

fabs = "fabs"
  { $$ = OP(0x0100d9e1); }

fadd = "fadd" (
    ws s:x87st ws? ',' ws? d:x87st_any
    {
        if (d.i64 == 0)
            $$ = OP(0x0100d8c0 | s.i64);
        else if (s.i64 == 0)
            $$ = OP(0x0100dcc0 | d.i64);
        else
            fatal("unsupported fadd destination register");
    }
  | ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported fadd source register");
        $$ = OP(0x0100dcc0 | d.i64);
    }
  | ws s:x87st { $$ = OP(0x0100d8c0 | s.i64); }
)

faddp = "faddp" (
    ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported faddp source register");
        $$ = OP(0x0100dec0 | d.i64);
    }
  | { $$ = OP(0x0100dec1); }
)

faddl = "faddl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdc, 0x00, s); }

fadds = "fadds" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd8, 0x00, s); }

fpatan = "fpatan"
  { $$ = OP(0x0100d9f3); }

fprem = "fprem"
  { $$ = OP(0x0100d9f8); }

fprem1 = "fprem1"
  { $$ = OP(0x0100d9f5); }

frndint = "frndint"
  { $$ = OP(0x0100d9fc); }

fscale = "fscale"
  { $$ = OP(0x0100d9fd); }

fsqrt = "fsqrt"
  { $$ = OP(0x0100d9fa); }

fyl2x = "fyl2x"
  { $$ = OP(0x0100d9f1); }

fyl2xp1 = "fyl2xp1"
  { $$ = OP(0x0100d9f9); }

fcomi = "fcomi" ws s:x87st ws? ',' ws? d:x87st_any
  {
      if (d.i64 != 0)
          fatal("unsupported fcomi destination register");
      $$ = OP(0x0100dbf0 | s.i64);
  }

fcomip = "fcomip" ws s:x87st ws? ',' ws? d:x87st_any
  {
      if (d.i64 != 0)
          fatal("unsupported fcomip destination register");
      $$ = OP(0x0100dff0 | s.i64);
  }

fcompi = "fcompi" ws s:x87st ws? ',' ws? d:x87st_any
  {
      if (d.i64 != 0)
          fatal("unsupported fcompi destination register");
      $$ = OP(0x0100dff0 | s.i64);
  }

fld1 = "fld1"
  { $$ = OP(0x0100d9e8); }

fldl2e = "fldl2e"
  { $$ = OP(0x0100d9ea); }

fldlg2 = "fldlg2"
  { $$ = OP(0x0100d9ec); }

fldln2 = "fldln2"
  { $$ = OP(0x0100d9ed); }

fldz = "fldz"
  { $$ = OP(0x0100d9ee); }

fldcw = "fldcw" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd9, 0x05, s); }

fldenv = "fldenv" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd9, 0x04, s); }

fldl = "fldl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdd, 0x00, s); }

flds = "flds" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd9, 0x00, s); }

fld = "fld" (
    't' ws s:mem { $$ = OPMEM({.w=0}, -1, 0xdb, 0x05, s); }
  | ws s:x87st { $$ = OP(0x0100d9c0 | s.i64); }
)

fdivp = "fdivp" (
    ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported fdivp source register");
        $$ = OP(0x0100def0 | d.i64);
    }
  | { $$ = OP(0x0100def1); }
)

fdiv = "fdiv" (
    ws s:x87st ws? ',' ws? d:x87st_any
    {
        if (d.i64 == 0)
            $$ = OP(0x0100d8f0 | s.i64);
        else if (s.i64 == 0)
            $$ = OP(0x0100dcf0 | d.i64);
        else
            fatal("unsupported fdiv destination register");
    }
  | ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported fdiv source register");
        $$ = OP(0x0100dcf0 | d.i64);
    }
  | ws s:x87st { $$ = OP(0x0100d8f0 | s.i64); }
)

fdivl = "fdivl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdc, 0x06, s); }

fdivs = "fdivs" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd8, 0x06, s); }

fdivrp = "fdivrp" (
    ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported fdivrp source register");
        $$ = OP(0x0100def8 | d.i64);
    }
  | ws d:x87st { $$ = OP(0x0100def8 | d.i64); }
  | { $$ = OP(0x0100def9); }
)

fdivr = "fdivr" (
    ws s:x87st ws? ',' ws? d:x87st_any
    {
        if (d.i64 == 0)
            $$ = OP(0x0100d8f8 | s.i64);
        else if (s.i64 == 0)
            $$ = OP(0x0100dcf8 | d.i64);
        else
            fatal("unsupported fdivr destination register");
    }
  | ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported fdivr source register");
        $$ = OP(0x0100dcf8 | d.i64);
    }
  | ws s:x87st { $$ = OP(0x0100d8f8 | s.i64); }
)

fdivrl = "fdivrl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdc, 0x07, s); }

fildl = "fildl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdb, 0x00, s); }

fildq = "fildq" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdf, 0x05, s); }

fildll = "fildll" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdf, 0x05, s); }

fimull = "fimull" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xda, 0x01, s); }

fiaddl = "fiaddl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xda, 0x00, s); }

fidivl = "fidivl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xda, 0x06, s); }

fidivrl = "fidivrl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xda, 0x07, s); }

fisubl = "fisubl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xda, 0x04, s); }

fisubrl = "fisubrl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xda, 0x05, s); }

fistl = "fistl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdb, 0x02, s); }

fistpll = "fistpll" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdf, 0x07, s); }

fistpl = "fistpl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdb, 0x03, s); }

fistpq = "fistpq" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdf, 0x07, s); }

fisttpll = "fisttpll" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdd, 0x01, s); }

fnclex = "fnclex"
  { $$ = OP(0x0100dbe2); }

fnstcw = "fnstcw" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd9, 0x07, s); }

fnstenv = "fnstenv" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd9, 0x06, s); }

fnstsw = "fnstsw" ws ax
  { $$ = OP(0x0100dfe0); }

fstcw = "fstcw" ws s:mem
  { $$ = OPMEM({.w=0}, 0x9b, 0xd9, 0x07, s); }

fstp = "fstp" ws s:x87st
  { $$ = OP(0x0100ddd8 | s.i64); }

fsts = "fsts" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd9, 0x02, s); }

fstl = "fstl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdd, 0x02, s); }

fstpl = "fstpl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdd, 0x03, s); }

fstps = "fstps" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd9, 0x03, s); }

fstpt = "fstpt" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdb, 0x07, s); }

fchs = "fchs"
  { $$ = OP(0x0100d9e0); }

fcmov = "fcmov" cc:fcmovcc ws s:x87st ws? ',' ws? d:x87st_any
  {
      if (d.i64 != 0)
          fatal("unsupported fcmov destination register");
      $$ = OP(0x01000000 | cc.i64 | s.i64);
  }

fcmovcc =
    "nbe" { $$.i64 = 0xdbd0; }
  | "nb"  { $$.i64 = 0xdbc0; }
  | "ne"  { $$.i64 = 0xdbc8; }
  | "nu"  { $$.i64 = 0xdbd8; }
  | "be"  { $$.i64 = 0xdad0; }
  | "b"   { $$.i64 = 0xdac0; }
  | "e"   { $$.i64 = 0xdac8; }
  | "u"   { $$.i64 = 0xdad8; }

fmulp = "fmulp" (
    ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported fmulp source register");
        $$ = OP(0x0100dec8 | d.i64);
    }
  | { $$ = OP(0x0100dec9); }
)

fmul = "fmul" (
    ws s:x87st ws? ',' ws? d:x87st_any
    {
        if (d.i64 == 0)
            $$ = OP(0x0100d8c8 | s.i64);
        else if (s.i64 == 0)
            $$ = OP(0x0100dcc8 | d.i64);
        else
            fatal("unsupported fmul destination register");
    }
  | ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported fmul source register");
        $$ = OP(0x0100dcc8 | d.i64);
    }
  | ws s:x87st { $$ = OP(0x0100d8c8 | s.i64); }
)

fmuls = "fmuls" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd8, 0x01, s); }

fmull = "fmull" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdc, 0x01, s); }

fsub = "fsub" (
    ws s:x87st ws? ',' ws? d:x87st_any
    {
        if (d.i64 == 0)
            $$ = OP(0x0100d8e0 | s.i64);
        else if (s.i64 == 0)
            $$ = OP(0x0100dce0 | d.i64);
        else
            fatal("unsupported fsub destination register");
    }
  | ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported fsub source register");
        $$ = OP(0x0100dce0 | d.i64);
    }
  | ws s:x87st { $$ = OP(0x0100d8e0 | s.i64); }
)

fsubl = "fsubl" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xdc, 0x04, s); }

fsubs = "fsubs" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd8, 0x04, s); }

fsubp = "fsubp" (
    ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported fsubp source register");
        $$ = OP(0x0100dee0 | d.i64);
    }
  | { $$ = OP(0x0100dee1); }
)

fsubr = "fsubr" (
    ws s:x87st ws? ',' ws? d:x87st_any
    {
        if (d.i64 == 0)
            $$ = OP(0x0100d8e8 | s.i64);
        else if (s.i64 == 0)
            $$ = OP(0x0100dce8 | d.i64);
        else
            fatal("unsupported fsubr destination register");
    }
  | ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported fsubr source register");
        $$ = OP(0x0100dce8 | d.i64);
    }
  | ws s:x87st { $$ = OP(0x0100d8e8 | s.i64); }
)

fsubrs = "fsubrs" ws s:mem
  { $$ = OPMEM({.w=0}, -1, 0xd8, 0x05, s); }

fsubrp = "fsubrp" (
    ws s:x87st_any ws? ',' ws? d:x87st
    {
        if (s.i64 != 0)
            fatal("unsupported fsubrp source register");
        $$ = OP(0x0100dee8 | d.i64);
    }
  | ws d:x87st { $$ = OP(0x0100dee8 | d.i64); }
  | { $$ = OP(0x0100dee9); }
)

fucomi = "fucomi" ws s:x87st ws? ',' ws? d:x87st_any
  {
      if (d.i64 != 0)
          fatal("unsupported fucomi destination register");
      $$ = OP(0x0100dbe8 | s.i64);
  }

fucomip = "fucomip" ws s:x87st ws? ',' ws? d:x87st_any
  {
      if (d.i64 != 0)
          fatal("unsupported fucomip destination register");
      $$ = OP(0x0100dfe8 | s.i64);
  }

fucompi = "fucompi" ws s:x87st ws? ',' ws? d:x87st_any
  {
      if (d.i64 != 0)
          fatal("unsupported fucompi destination register");
      $$ = OP(0x0100dfe8 | s.i64);
  }

fxch = "fxch" (
    ws s:x87st { $$ = OP(0x0100d9c8 | s.i64); }
  | { $$ = OP(0x0100d9c9); }
)

addsd = "addsd" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0xf2, 0x01000f58, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0xf2, 0x01000f58, s, d); }
)

addpd = "addpd" (
    ws s:xmm ws? ',' ws? d:xmm { $$ = REGREG2({.w=0}, 0x66, 0x01000f58, s, d); }
  | ws s:mem ws? ',' ws? d:xmm { $$ = MEMREG ({.w=0}, 0x66, 0x01000f58, s, d); }
)

