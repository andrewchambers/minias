  | 'w'? ws d:r16 { $$ = OPREG({.w=0}, 0x66, 0xd1, 0x05, d); }
  | 'l'? ws d:r32 { $$ = OPREG({.w=0},   -1, 0xd1, 0x05, d); }
  | 'q'? ws d:r64 { $$ = OPREG({.w=1},   -1, 0xd1, 0x05, d); }
)

rol = "rol" (
    'b'  ws c:cl   ws? ',' ws? d:mem { $$ = OPMEM({.w=0},   -1, 0xd2, 0x00, d); }
  | 'w'  ws c:cl   ws? ',' ws? d:mem { $$ = OPMEM({.w=0}, 0x66, 0xd3, 0x00, d); }
